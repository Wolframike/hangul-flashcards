 "sentences": [
  {
   "id": "s01",
   "row": 1,
   "ko": "오늘은 월요일입니다.",
   "ja": "今日は月曜日です。",
   "pron": [
    "오느른 워료이림니다"
   ],
   "rom": [
    "oneureun woryoirimnida"
   ],
   "note": "連音化、鼻音化",
   "hanja": "오늘은 月曜日입니다."
  },
  {
   "id": "s02",
   "row": 2,
   "ko": "역에서 학교까지 십오 분 정도 걸립니다.",
   "ja": "駅から学校まで15分ぐらいかかります。",
   "pron": [
    "여게서 학꾜까지 시보 분 정도 걸림니다"
   ],
   "rom": [
    "yeogeseo hakkyokkaji sibo bun jeongdo geollimnida"
   ],
   "note": "連音化、濃音化、鼻音化",
   "hanja": "驛에서 學校까지 十五 分 程度 걸립니다."
  },
  {
   "id": "s03",
   "row": 3,
   "ko": "성함이 어떻게 되세요?",
   "ja": "お名前は何ですか。",
   "pron": [
    "성아미 어떠케 뒈세요",
    "성하미 어떠케 되세요"
   ],
   "rom": [
    "seong-ami eotteoke dweseyo",
    "seonghami eotteoke doeseyo"
   ],
   "note": "ㅎの弱化、連音化、激音化、ㅚは[ㅞ]",
   "hanja": "姓銜이 어떻게 되세요?"
  },
  {
   "id": "s04",
   "row": 4,
   "ko": "좋아요! 이따가 백화점에 같이 갑시다.",
   "ja": "いいですよ！あとでデパートに一緒に行きましょう。",
   "pron": [
    "조아요 이따가 배콰저메 가치 갑씨다"
   ],
   "rom": [
    "joayo ittaga baekwajeome gachi gapssida"
   ],
   "note": "ㅎの脱落、激音化、連音化、口蓋音化、濃音化",
   "hanja": "좋아요! 이따가 百貨店에 같이 갑시다."
  },
  {
   "id": "s05",
   "row": 5,
   "ko": "무궁화 꽃이 피었습니다.",
   "ja": "ムクゲの花が咲きました。",
   "pron": [
    "무궁와 꼬치 피얻씀니다",
    "무궁화 꼬치 피얻씀니다"
   ],
   "rom": [
    "mugung-wa kkochi pieotsseumnida",
    "mugunghwa kkochi pieotsseumnida"
   ],
   "note": "ㅎの弱化、連音化、濃音化、鼻音化",
   "hanja": "無窮花 꽃이 피었습니다."
  },
  {
   "id": "s06",
   "row": 6,
   "ko": "저는 따뜻한 봄을 좋아해요.",
   "ja": "私は暖かい春が好きです。",
   "pron": [
    "저는 따뜨탄 보믈 조아해요"
   ],
   "rom": [
    "jeoneun ttatteutan bomeul joahaeyo"
   ],
   "note": "激音化、連音化、ㅎの脱落"
  },
  {
   "id": "s07",
   "row": 7,
   "ko": "굳이 얘기하고 싶지 않아요.",
   "ja": "敢えて話したくありません。",
   "pron": [
    "구지 얘기하고 십찌 아나요"
   ],
   "rom": [
    "guji yaegihago sipjji anayo"
   ],
   "note": "口蓋音化、濃音化、ㅎの脱落、連音化"
  },
  {
   "id": "s08",
   "row": 8,
   "ko": "여기에 앉아서 국밥을 먹을까요?",
   "ja": "ここに座ってクッパ（スープご飯）を食べましょうか。",
   "pron": [
    "여기에 안자서 국빠블 머글까요"
   ],
   "rom": [
    "yeogie anjaseo gukppabeul meogeulkkayo"
   ],
   "note": "連音化、濃音化"
  },
  {
   "id": "s09",
   "row": 9,
   "ko": "오빠가 한국어 교과서를 잃어버렸어요.",
   "ja": "お兄さんが韓国語の教科書を無くしました。",
   "pron": [
    "오빠가 한구거 교과서를 이러버려써요"
   ],
   "rom": [
    "oppaga hangugeo gyogwaseoreul ireobeoryeosseoyo"
   ],
   "note": "連音化、ㅎの脱落（교과서は[교꽈서]とも）",
   "hanja": "오빠가 韓國語 敎科書를 잃어버렸어요."
  },
  {
   "id": "s10",
   "row": 10,
   "ko": "설날에는 친척들이 많이 모여요.",
   "ja": "お正月には親戚がたくさん集まります。",
   "pron": [
    "설라레는 친척뜨리 마니 모여요"
   ],
   "rom": [
    "seollareneun chincheoktteuri mani moyeoyo"
   ],
   "note": "流音化、連音化、濃音化、ㅎの脱落",
   "hanja": "설날에는 親戚들이 많이 모여요."
  }
 ]
